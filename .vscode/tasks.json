{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build Fable3.exe",
            "type": "shell",
            "command": "cmd /c build_vs2008_debug.bat",
            "options": {
                "cwd": "${workspaceFolder}\\Fable 3"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": "$msCompile"
        }
    ]
}
