# ============================================================
#  Fable 3 Launcher — .gitignore
#  Ignores IDE caches, per-user settings, and build output so
#  only source (.cpp/.rc/.xml/.bat/.py), the .vcxproj/.slnx,
#  and the res\ source assets (fable.ico, manifest.xml, the
#  reference .bin extractions) are tracked.
# ============================================================

# ---- Visual Studio / MSBuild ----
# IDE cache
.vs/

# Per-user project settings
*.user

# Build output + MSBuild intermediate directories
Release/
Debug/
Fable 3 Launcher/

# ---- Extracted copyrighted icon assets ----
# Regenerated from the original binary by extract_icons.py (run at build
time), so they are never committed.
res/fable.ico
res/icon*.bin
res/groupicon.bin

# ---- Compiled build artifacts (safety net if any land elsewhere) ----
*.obj
*.iobj
*.ipdb
*.pdb
*.res
*.tlog
*.recipe
*.lastbuildstate
*.Build.CppClean.log
*.FileListAbsolute.txt

# ---- Python ----
__pycache__/
*.pyc
*.pyo
